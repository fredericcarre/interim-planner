rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Block all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data - strictly isolated by user ID
    match /users/{userId} {
      // User can only access their own data
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read: if isOwner();
        allow write: if isOwner() && request.resource.data.keys().hasAll(['netCoefficient', 'currency']);
      }

      // Establishments subcollection
      match /establishments/{establishmentId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(['name', 'defaultHourlyRate', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.defaultHourlyRate is number
          && request.resource.data.defaultHourlyRate >= 0;
        allow update: if isOwner()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.defaultHourlyRate is number
          && request.resource.data.defaultHourlyRate >= 0;
        allow delete: if isOwner();
      }

      // Work entries subcollection
      match /workEntries/{entryId} {
        allow read: if isOwner()
          || (request.auth != null
            && get(/databases/$(database)/documents/shareAccess/$(userId)/viewers/$(request.auth.uid)).data.active == true);
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(['date', 'establishmentId', 'establishmentNameSnapshot', 'hours', 'hourlyRate', 'createdAt', 'updatedAt'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.hours is number
          && request.resource.data.hours > 0
          && request.resource.data.hours <= 24
          && request.resource.data.hourlyRate is number
          && request.resource.data.hourlyRate >= 0;
        allow update: if isOwner()
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.hours is number
          && request.resource.data.hours > 0
          && request.resource.data.hours <= 24
          && request.resource.data.hourlyRate is number
          && request.resource.data.hourlyRate >= 0;
        allow delete: if isOwner();
      }

      // User's share links (for tracking which months have been shared)
      match /shares/{shareId} {
        allow read, write: if isOwner();
      }

      match /planningShare/{shareId} {
        allow read, write: if isOwner();
      }

      match /sharedPlannings/{ownerId} {
        allow read, create, update, delete: if isOwner()
          && request.auth.uid != ownerId
          && (request.method == 'delete' || request.resource.data.ownerId == ownerId);
      }
    }

    // Public shares collection - readable by anyone, writable by authenticated users
    match /shares/{token} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['token', 'userId', 'month', 'entries', 'summary', 'createdAt']);
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // A QR/link is only an invitation. It grants access once accepted by an
    // authenticated account and can be disabled without exposing planning data.
    match /planningInvitations/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.token == token
        && request.resource.data.active == true;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /shareAccess/{ownerId}/viewers/{viewerId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.uid == viewerId);
      allow create: if request.auth != null
        && request.auth.uid == viewerId
        && request.resource.data.userId == viewerId
        && request.resource.data.active == true
        && get(/databases/$(database)/documents/planningInvitations/$(request.resource.data.invitationToken)).data.ownerId == ownerId
        && get(/databases/$(database)/documents/planningInvitations/$(request.resource.data.invitationToken)).data.active == true;
      allow update: if request.auth != null
        && request.auth.uid == ownerId
        && resource.data.userId == viewerId;
      allow delete: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.uid == viewerId);
    }
  }
}
